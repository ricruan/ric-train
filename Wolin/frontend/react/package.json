{
  "name": "interview-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev:user": "pnpm --filter @interview/user dev",
    "dev:admin": "pnpm --filter @interview/admin dev",
    "dev": "pnpm run dev:user & pnpm run dev:admin",
    "build:user": "pnpm --filter @interview/user build",
    "build:admin": "pnpm --filter @interview/admin build",
    "build": "pnpm run build:user && pnpm run build:admin",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2"
  }
}
